<script>
(function () {
    var lb = document.getElementById('tnt-lb');
    if (!lb) { return; }
    var img = lb.querySelector('.tnt-lb__img');
    var cap = lb.querySelector('.tnt-lb__cap');
    var list = [], idx = 0, opener = null;

    function show(i) {
        idx = (i + list.length) % list.length;
        var c = list[idx];
        img.src = c.getAttribute('data-full');
        img.alt = c.getAttribute('data-title') + ' — ' + c.getAttribute('data-sub');
        cap.querySelector('strong').textContent = c.getAttribute('data-title');
        cap.querySelector('span').textContent = c.getAttribute('data-sub');
        cap.querySelector('em').textContent = list.length > 1 ? (idx + 1) + ' / ' + list.length : '';
        lb.classList.toggle('is-single', list.length < 2);
    }
    function open(card) {
        var g = card.getAttribute('data-group');
        list = Array.prototype.slice.call(document.querySelectorAll('[data-nm-open][data-group="' + g + '"]'));
        opener = card;
        show(list.indexOf(card));
        lb.hidden = false;
        document.documentElement.classList.add('tnt-lb-open');
        lb.querySelector('.tnt-lb__close').focus();
    }
    function close() {
        lb.hidden = true;
        img.src = '';
        document.documentElement.classList.remove('tnt-lb-open');
        if (opener) { opener.focus(); }
    }

    document.addEventListener('click', function (e) {
        var card = e.target.closest('[data-nm-open]');
        if (card) { open(card); return; }
        var name = e.target.closest('[data-nm-name]');
        if (name) {
            var first = document.querySelector('[data-nm-open][data-factory="' + name.getAttribute('data-factory') + '"]');
            if (first) { open(first); }
            return;
        }
        if (lb.hidden) { return; }
        if (e.target.closest('[data-lb-close]')) { close(); }
        else if (e.target.closest('[data-lb-prev]')) { show(idx - 1); }
        else if (e.target.closest('[data-lb-next]')) { show(idx + 1); }
    });
    document.addEventListener('keydown', function (e) {
        if (lb.hidden) { return; }
        if (e.key === 'Escape') { close(); }
        else if (e.key === 'ArrowLeft') { show(idx - 1); }
        else if (e.key === 'ArrowRight') { show(idx + 1); }
    });
})();
</script>

