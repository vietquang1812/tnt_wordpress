/* ==========================================================
   TNT – Vật tư Xây dựng | Giao diện chính
   Màu thương hiệu: xanh lá #114D22, đỏ #D0141C
   ========================================================== */
:root {
  /* Màu thương hiệu lấy từ logo: xanh lá đậm (sọc + viền elip) & đỏ (chữ TNT) */
  --tnt-primary: #114d22;
  --tnt-primary-deep: #072a10;
  --tnt-accent: #d0141c;
  --tnt-accent-dark: #a30f16;
  --tnt-accent-soft: #fdeceb;
  --tnt-green-soft: #e8f1ea;
  --tnt-ink: #142018;
  --tnt-muted: #5b6a5f;
  --tnt-line: #dde4dc;
  --tnt-tint: #f4f6f3;
  --tnt-radius: 10px;
  --tnt-shadow: 0 10px 30px -12px rgba(7, 42, 16, .3);
  /* Họa tiết sọc ngang giống logo */
  --tnt-stripes: repeating-linear-gradient(180deg, var(--tnt-primary) 0 8px, transparent 8px 20px);
  --tnt-stripes-light: repeating-linear-gradient(180deg, rgba(255, 255, 255, .14) 0 8px, transparent 8px 20px);
  --bs-body-font-family: "Be Vietnam Pro", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --bs-body-color: var(--tnt-ink);
  --bs-link-color-rgb: 17, 77, 34;
}

body { font-family: var(--bs-body-font-family); color: var(--tnt-ink); background: #fff; line-height: 1.65; }
img { max-width: 100%; }
h1, h2, h3, h4 { font-weight: 700; letter-spacing: -.01em; }
a { color: var(--tnt-primary); }
.tnt-icon { width: 1.15em; height: 1.15em; flex: none; vertical-align: -.2em; }

/* ---------- Buttons ---------- */
.tnt-btn { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; border-radius: 6px; padding: .6rem 1.2rem; border: 2px solid transparent; transition: .2s; }
.tnt-btn.btn-lg { padding: .8rem 1.5rem; font-size: 1rem; }
.tnt-btn--accent { background: var(--tnt-accent); color: #fff; }
.tnt-btn--accent:hover { background: var(--tnt-accent-dark); color: #fff; }
.tnt-btn--primary { background: var(--tnt-primary); color: #fff; }
.tnt-btn--primary:hover { background: var(--tnt-primary-deep); color: #fff; }
.tnt-btn--ghost { border-color: rgba(255, 255, 255, .7); color: #fff; }
.tnt-btn--ghost:hover { background: #fff; color: var(--tnt-primary); }
.tnt-link { display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; text-decoration: none; color: var(--tnt-primary); }
.tnt-link .tnt-icon { transition: transform .2s; }
.tnt-link:hover .tnt-icon { transform: translateX(4px); }

/* ---------- Topbar & header ---------- */
.tnt-topbar { background: var(--tnt-primary-deep); color: #cfdccf; font-size: .85rem; padding: .45rem 0; }
.tnt-topbar a { color: #fff; text-decoration: none; }
.tnt-topbar a, .tnt-topbar span { display: inline-flex; align-items: center; gap: .4rem; }
.tnt-topbar .tnt-icon { color: var(--tnt-accent); width: 1em; height: 1em; }

.tnt-header { background: #fff; border-bottom: 1px solid var(--tnt-line); transition: box-shadow .2s; }
.tnt-header.is-scrolled { box-shadow: 0 6px 20px -10px rgba(0, 0, 0, .25); }
.tnt-header .navbar { padding: .75rem 0; }
.tnt-brand { display: inline-flex; align-items: center; gap: .7rem; text-decoration: none; }
.tnt-brand__mark { display: block; flex: none; }
.tnt-brand__mark img { display: block; width: 78px; height: auto; }
.tnt-brand__text { display: flex; flex-direction: column; line-height: 1.15; }
.tnt-brand__text small { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--tnt-muted); font-weight: 600; }
.tnt-brand__text strong { font-size: 1.05rem; color: var(--tnt-primary); text-transform: uppercase; font-weight: 800; }
.tnt-brand__text strong em { font-style: normal; color: var(--tnt-accent); }
.tnt-brand--light .tnt-brand__text small { color: #a3b8a5; }
.tnt-brand--light .tnt-brand__text strong { color: #fff; }
.tnt-brand--light .tnt-brand__text strong em { color: #ff4b52; }

.tnt-header .nav-link { font-weight: 600; color: var(--tnt-ink); padding: .5rem 1rem !important; position: relative; }
.tnt-header .nav-link:hover, .tnt-header .nav-link.active, .tnt-header .current-menu-item > .nav-link { color: var(--tnt-primary); }
@media (min-width: 992px) {
  .tnt-header .nav-link::after { content: ""; position: absolute; left: 1rem; right: 1rem; bottom: -.95rem; height: 3px; background: var(--tnt-accent); transform: scaleX(0); transition: transform .2s; }
  .tnt-header .nav-link:hover::after, .tnt-header .nav-link.active::after, .tnt-header .current-menu-item > .nav-link::after { transform: scaleX(1); }
}
.navbar-toggler { border-color: var(--tnt-line); }

/* ---------- Common sections ---------- */
.tnt-section { padding: 88px 0; }
.tnt-section--tint { background: var(--tnt-tint); }
.tnt-section--dark { background: var(--tnt-primary-deep); color: #cfdccf; }
.tnt-section--dark .tnt-heading { color: #fff; }
.tnt-section__head { max-width: 720px; margin-bottom: 48px; }
.tnt-section__head p { color: var(--tnt-muted); }
.tnt-section--dark .tnt-section__head p { color: #a3b8a5; }
.tnt-eyebrow { display: inline-flex; align-items: center; gap: .6rem; font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--tnt-accent); margin-bottom: .75rem; }
.tnt-eyebrow::before { content: ""; width: 28px; height: 3px; background: currentColor; }
.text-center .tnt-eyebrow::after { content: ""; width: 28px; height: 3px; background: currentColor; }
.tnt-eyebrow--light { color: #fff; }
.tnt-eyebrow--light::before, .text-center .tnt-eyebrow--light::after { background: var(--tnt-accent); }
.tnt-heading { font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem); color: var(--tnt-primary); margin-bottom: 1rem; line-height: 1.2; }

/* ---------- Hero ---------- */
.tnt-hero, .tnt-page-hero { position: relative; overflow: hidden; color: #fff;
  background: linear-gradient(100deg, rgba(7, 42, 16, .97) 0%, rgba(17, 77, 34, .82) 45%, rgba(17, 77, 34, .3) 100%), var(--hero-img) center / cover no-repeat var(--tnt-primary-deep); background-blend-mode: normal, luminosity; }
@media (max-width: 767.98px) { .tnt-hero, .tnt-page-hero { background: linear-gradient(rgba(7, 42, 16, .9), rgba(17, 77, 34, .85)), var(--hero-img) center / cover no-repeat var(--tnt-primary-deep); background-blend-mode: normal, luminosity; } }
.tnt-hero { padding: 110px 0 150px; }
.tnt-hero__title { font-size: clamp(2.1rem, 1.3rem + 3vw, 3.6rem); font-weight: 800; line-height: 1.12; margin-bottom: 1.25rem; }
.tnt-hero__title span { color: #fff; background: linear-gradient(var(--tnt-accent), var(--tnt-accent)) left 92% / 100% .14em no-repeat; padding-bottom: .05em; }
.tnt-hero__lead { font-size: 1.1rem; color: #dbe6db; max-width: 600px; margin-bottom: 2rem; }
.tnt-hero__slash { position: absolute; right: 0; bottom: 0; width: 38%; height: 14px; background: var(--tnt-accent); clip-path: polygon(4% 0, 100% 0, 100% 100%, 0 100%); }
.tnt-hero::after, .tnt-page-hero::after { content: ""; position: absolute; top: 0; right: 0; width: 26%; height: 100%; background: var(--tnt-stripes-light); -webkit-mask-image: linear-gradient(90deg, transparent, #000 60%); mask-image: linear-gradient(90deg, transparent, #000 60%); pointer-events: none; }

.tnt-page-hero { padding: 72px 0 80px; background: linear-gradient(100deg, rgba(7, 42, 16, .96) 0%, rgba(17, 77, 34, .85) 50%, rgba(17, 77, 34, .45) 100%), var(--hero-img) center / cover no-repeat var(--tnt-primary-deep); background-blend-mode: normal, luminosity; }
.tnt-page-hero h1 { font-size: clamp(1.9rem, 1.3rem + 2vw, 2.8rem); font-weight: 800; margin: .5rem 0; }
.tnt-page-hero p { color: #dbe6db; max-width: 640px; margin: 0; }
.tnt-breadcrumb { font-size: .875rem; color: #a3b8a5; display: flex; gap: .5rem; }
.tnt-breadcrumb a { color: #fff; text-decoration: none; }

/* ---------- Stats ---------- */
.tnt-stats { position: relative; margin-top: -70px; z-index: 2; }
.tnt-stats__grid { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: var(--tnt-radius); box-shadow: var(--tnt-shadow); overflow: hidden; }
.tnt-stats__grid > div { padding: 28px 24px; border-left: 1px solid var(--tnt-line); display: flex; flex-direction: column; }
.tnt-stats__grid > div:first-child { border-left: 0; }
.tnt-stats__grid strong { font-size: 2.2rem; font-weight: 800; color: var(--tnt-primary); line-height: 1; }
.tnt-stats__grid span { color: var(--tnt-muted); font-size: .9rem; margin-top: .4rem; }
@media (max-width: 767.98px) {
  .tnt-stats__grid { grid-template-columns: repeat(2, 1fr); }
  .tnt-stats__grid > div:nth-child(3) { border-left: 0; }
  .tnt-stats__grid > div:nth-child(n+3) { border-top: 1px solid var(--tnt-line); }
}

/* ---------- About ---------- */
.tnt-about__media { position: relative; padding: 0 0 28px 28px; }
.tnt-about__media::before { content: ""; position: absolute; left: 0; bottom: 0; width: 75%; height: 72%; background: var(--tnt-stripes); }
.tnt-about__media img { position: relative; border-radius: var(--tnt-radius); aspect-ratio: 4 / 4.2; object-fit: cover; width: 100%; object-position: 78% center; }
.tnt-checklist { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .75rem 1.5rem; }
.tnt-checklist li { display: flex; gap: .6rem; align-items: center; font-weight: 600; }
.tnt-checklist .tnt-icon { color: #fff; background: var(--tnt-accent); border-radius: 50%; padding: 3px; width: 22px; height: 22px; }
@media (max-width: 575.98px) { .tnt-checklist { grid-template-columns: 1fr; } }

/* ---------- Values ---------- */
.tnt-value { background: #fff; border-radius: var(--tnt-radius); padding: 36px 30px; height: 100%; border-top: 4px solid var(--tnt-accent); box-shadow: 0 2px 0 var(--tnt-line); transition: transform .2s, box-shadow .2s; }
.tnt-value:hover { transform: translateY(-4px); box-shadow: var(--tnt-shadow); }
.tnt-value__icon { width: 60px; height: 60px; border-radius: 12px; background: var(--tnt-green-soft); color: var(--tnt-primary); display: grid; place-items: center; margin-bottom: 1.25rem; }
.tnt-value__icon .tnt-icon { width: 30px; height: 30px; }
.tnt-value h3 { font-size: 1.25rem; color: var(--tnt-primary); }
.tnt-value p { color: var(--tnt-muted); margin: 0; }

/* ---------- Category cards ---------- */
.tnt-cat { display: block; text-decoration: none; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); overflow: hidden; background: #fff; height: 100%; transition: .2s; }
.tnt-cat:hover { border-color: var(--tnt-accent); box-shadow: var(--tnt-shadow); transform: translateY(-3px); }
.tnt-cat__img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--tnt-tint); }
.tnt-cat__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.tnt-cat:hover .tnt-cat__img img { transform: scale(1.06); }
.tnt-cat__body { display: flex; justify-content: space-between; align-items: center; gap: .75rem; padding: 16px 18px; }
.tnt-cat__body h3 { font-size: 1rem; margin: 0; color: var(--tnt-ink); }
.tnt-cat__body span { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--tnt-green-soft); color: var(--tnt-primary); transition: .2s; }
.tnt-cat:hover .tnt-cat__body span { background: var(--tnt-accent); color: #fff; }

/* ---------- Project fields ---------- */
.tnt-field { position: relative; margin: 0; border-radius: var(--tnt-radius); overflow: hidden; aspect-ratio: 3 / 4; }
.tnt-field img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.tnt-field:hover img { transform: scale(1.06); }
.tnt-field figcaption { position: absolute; inset: auto 0 0 0; padding: 60px 22px 22px; background: linear-gradient(transparent, rgba(4, 24, 9, .95)); }
.tnt-field h3 { color: #fff; font-size: 1.15rem; margin-bottom: .35rem; }
.tnt-field h3::before { content: ""; display: block; width: 32px; height: 3px; background: var(--tnt-accent); margin-bottom: .75rem; }
.tnt-field p { color: #cfdccf; font-size: .9rem; margin: 0; }

/* ---------- Pillars ---------- */
.tnt-pillar { display: flex; gap: 1rem; padding: 22px; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); height: 100%; }
.tnt-pillar > .tnt-icon { width: 40px; height: 40px; padding: 8px; border-radius: 8px; background: var(--tnt-primary); color: #fff; }
.tnt-pillar h3 { font-size: 1.02rem; margin-bottom: .25rem; color: var(--tnt-primary); }
.tnt-pillar p { margin: 0; color: var(--tnt-muted); font-size: .92rem; }

/* ---------- CTA ---------- */
.tnt-cta { padding: 0 0 88px; }
.tnt-section--tint + .tnt-cta, .tnt-pgroup.tnt-section--tint + .tnt-cta { background: var(--tnt-tint); }
.tnt-cta__box { position: relative; overflow: hidden; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; padding: 48px 56px; border-radius: 14px; color: #fff;
  background: linear-gradient(110deg, var(--tnt-primary-deep), var(--tnt-primary) 60%, #1d6b34); }
.tnt-cta__box::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 220px; background: var(--tnt-stripes-light); -webkit-mask-image: linear-gradient(90deg, transparent, #000 70%); mask-image: linear-gradient(90deg, transparent, #000 70%); }
.tnt-cta__box::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--tnt-accent); }
.tnt-cta__box > * { position: relative; z-index: 1; }
.tnt-cta__box h2 { font-size: clamp(1.4rem, 1rem + 1.2vw, 2rem); margin-bottom: .4rem; }
.tnt-cta__box p { color: #cfdccf; margin: 0; }
.tnt-cta__box > div:last-child { margin-right: 90px; }
@media (max-width: 767.98px) { .tnt-cta__box { padding: 36px 26px; } .tnt-cta__box::after { display: none; } .tnt-cta__box > div:last-child { margin-right: 0; } }

/* ---------- Product page ---------- */
.tnt-catnav { position: sticky; top: 73px; z-index: 10; background: #fff; border-bottom: 1px solid var(--tnt-line); }
.tnt-catnav ul { list-style: none; margin: 0; padding: 0; display: flex; gap: .25rem; overflow-x: auto; scrollbar-width: none; }
.tnt-catnav ul::-webkit-scrollbar { display: none; }
.tnt-catnav a { display: block; white-space: nowrap; padding: 1rem .9rem; font-weight: 600; font-size: .92rem; color: var(--tnt-muted); text-decoration: none; border-bottom: 3px solid transparent; }
.tnt-catnav a:hover, .tnt-catnav a.is-active { color: var(--tnt-primary); border-bottom-color: var(--tnt-accent); }
.tnt-pgroup { scroll-margin-top: 130px; padding: 72px 0; }
.tnt-pgroup__head { display: flex; gap: 1.5rem; align-items: flex-start; margin-bottom: 36px; max-width: 820px; }
.tnt-pgroup__head p { color: var(--tnt-muted); }
.tnt-pgroup__num { font-size: 3rem; font-weight: 800; line-height: .9; color: transparent; -webkit-text-stroke: 1.5px var(--tnt-accent); }

.tnt-product { background: #fff; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); overflow: hidden; height: 100%; display: flex; flex-direction: column; }
.tnt-product__gallery { display: grid; grid-template-columns: repeat(var(--cols, 3), 1fr); gap: 4px; padding: 4px; background: #fff; }
.tnt-product__img { border: 0; padding: 0; background: var(--tnt-tint); overflow: hidden; border-radius: 6px; cursor: zoom-in; aspect-ratio: 4 / 3; }
.tnt-product__img.is-main { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
.tnt-product__img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.tnt-product__img:hover img { transform: scale(1.05); }
.tnt-product__body { padding: 20px 22px 22px; display: flex; flex-direction: column; flex: 1; }
.tnt-product__body h3 { font-size: 1.12rem; color: var(--tnt-primary); }
.tnt-product__body p { color: var(--tnt-muted); flex: 1; }
.tnt-product--wide { flex-direction: row; }
.tnt-product--wide .tnt-product__gallery { flex: 0 0 58%; grid-template-columns: repeat(var(--cols, 3), 1fr); align-content: center; }
.tnt-product--wide .tnt-product__img { aspect-ratio: 4 / 3; }
.tnt-product--wide .tnt-product__img.is-main { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
.tnt-product--wide .tnt-product__body { justify-content: center; padding: 28px 32px; }
@media (max-width: 767.98px) { .tnt-product--wide { flex-direction: column; } .tnt-product--wide .tnt-product__gallery { flex: none; } }

.tnt-types { background: var(--tnt-primary-deep); color: #cfdccf; border-radius: var(--tnt-radius); padding: 28px; height: 100%; }
.tnt-types h3 { color: #fff; font-size: 1.1rem; }
.tnt-types ul { list-style: none; padding: 0; margin: 1rem 0 1.25rem; display: flex; flex-wrap: wrap; gap: .45rem; }
.tnt-types li { font-size: .82rem; padding: .3rem .7rem; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .15); color: #fff; }
.tnt-types strong { color: var(--tnt-accent); }

/* ---------- Certificates ---------- */
.tnt-cert { display: grid; grid-template-columns: 220px 1fr; gap: 0; background: #fff; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); overflow: hidden; height: 100%; }
.tnt-cert__img { position: relative; border: 0; padding: 18px; background: var(--tnt-primary) var(--tnt-stripes-light); cursor: zoom-in; }
.tnt-cert__img img { width: 100%; height: 100%; object-fit: contain; background: #fff; border-radius: 4px; }
.tnt-cert__img span { position: absolute; right: 26px; bottom: 26px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: var(--tnt-accent); color: #fff; }
.tnt-cert__body { padding: 26px 28px; }
.tnt-cert__tag { display: inline-flex; align-items: center; gap: .4rem; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--tnt-accent); margin-bottom: .5rem; }
.tnt-cert h3 { font-size: 1.2rem; color: var(--tnt-primary); margin-bottom: 1rem; }
.tnt-cert dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: .5rem 1rem; font-size: .92rem; }
.tnt-cert dt { color: var(--tnt-muted); font-weight: 500; }
.tnt-cert dd { margin: 0; font-weight: 600; }
@media (max-width: 575.98px) { .tnt-cert { grid-template-columns: 1fr; } .tnt-cert__img { height: 300px; } .tnt-cert dl { grid-template-columns: 1fr; gap: 0; } .tnt-cert dd { margin-bottom: .5rem; } }

.tnt-standard { background: #fff; border-radius: var(--tnt-radius); padding: 22px 24px; height: 100%; border-left: 4px solid var(--tnt-accent); }
.tnt-standard strong { display: block; font-size: 1.25rem; color: var(--tnt-primary); margin-bottom: .25rem; }
.tnt-standard p { margin: 0; color: var(--tnt-muted); font-size: .92rem; }

.tnt-coq { display: flex; align-items: center; gap: 1.75rem; padding: 36px 40px; border: 2px dashed var(--tnt-primary); border-radius: 14px; background: var(--tnt-green-soft); }
.tnt-coq h2 { font-size: 1.35rem; color: var(--tnt-primary); }
.tnt-coq p { color: var(--tnt-muted); }
.tnt-coq__icon { flex: none; width: 68px; height: 68px; border-radius: 50%; background: var(--tnt-accent); color: #fff; display: grid; place-items: center; }
.tnt-coq__icon .tnt-icon { width: 34px; height: 34px; }
.tnt-coq .btn { flex: none; }
@media (max-width: 767.98px) { .tnt-coq { flex-direction: column; align-items: flex-start; padding: 28px; } }

/* ---------- Contact ---------- */
.tnt-contact-card { background: #fff; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); padding: 28px; height: 100%; }
.tnt-contact-card__icon { width: 52px; height: 52px; border-radius: 12px; display: grid; place-items: center; background: var(--tnt-primary); color: #fff; margin-bottom: 1rem; }
.tnt-contact-card h3 { font-size: .85rem; text-transform: uppercase; letter-spacing: .08em; color: var(--tnt-muted); }
.tnt-contact-card__big { display: block; font-size: 1.3rem; font-weight: 700; color: var(--tnt-primary); text-decoration: none; margin-bottom: .25rem; word-break: break-word; }
.tnt-contact-card p { color: var(--tnt-muted); }

.tnt-form { background: var(--tnt-tint); border-radius: var(--tnt-radius); padding: 28px; }
.tnt-form .form-label { font-weight: 600; font-size: .9rem; }
.tnt-form .form-control { border-color: var(--tnt-line); padding: .7rem .9rem; }
.tnt-form .form-control:focus { border-color: var(--tnt-accent); box-shadow: 0 0 0 .2rem rgba(208, 20, 28, .15); }
.tnt-form .btn { justify-content: center; }
.tnt-hp { position: absolute; left: -9999px; }

.tnt-locations { display: grid; gap: .6rem; margin-bottom: 1rem; }
.tnt-location { display: flex; gap: .85rem; align-items: flex-start; text-align: left; width: 100%; background: #fff; border: 1px solid var(--tnt-line); border-radius: var(--tnt-radius); padding: 14px 18px; transition: .2s; }
.tnt-location .tnt-icon { color: var(--tnt-accent); margin-top: .15rem; }
.tnt-location strong { display: block; color: var(--tnt-primary); }
.tnt-location span { color: var(--tnt-muted); font-size: .92rem; }
.tnt-location:hover { border-color: var(--tnt-accent); }
.tnt-location.is-active { border-color: var(--tnt-primary); box-shadow: inset 4px 0 0 var(--tnt-accent); }
.tnt-map { border-radius: var(--tnt-radius); overflow: hidden; background: var(--tnt-tint); aspect-ratio: 16 / 10; border: 1px solid var(--tnt-line); }
.tnt-map iframe { width: 100%; height: 100%; border: 0; display: block; }

/* ---------- Footer ---------- */
.tnt-footer { background: var(--tnt-primary-deep); color: #a3b8a5; padding: 72px 0 0; font-size: .93rem; position: relative; }
.tnt-footer::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 5px; background: linear-gradient(90deg, var(--tnt-accent) 0 34%, transparent 34%); }
.tnt-footer .tnt-brand__mark img { width: 92px; filter: drop-shadow(0 2px 6px rgba(0, 0, 0, .35)); }
.tnt-footer a { color: #dde8dd; text-decoration: none; }
.tnt-footer a:hover { color: var(--tnt-accent); }
.tnt-footer__title { color: #fff; font-size: 1rem; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 1.1rem; }
.tnt-footer ul li { margin-bottom: .55rem; }
.tnt-footer__contact li { display: flex; gap: .7rem; }
.tnt-footer__contact .tnt-icon { color: var(--tnt-accent); margin-top: .2rem; }
.tnt-footer__contact strong { color: #fff; font-weight: 600; }
.tnt-footer__bottom { margin-top: 56px; padding: 20px 0; border-top: 1px solid rgba(255, 255, 255, .08); font-size: .85rem; }

/* ---------- Misc ---------- */
.tnt-prose { max-width: 820px; }
#tntZoom .modal-content img { background: #fff; max-height: 85vh; object-fit: contain; }

@media (max-width: 991.98px) {
  .tnt-section { padding: 64px 0; }
  .tnt-hero { padding: 80px 0 130px; }
  .tnt-catnav { top: 73px; }
  .tnt-header .navbar-collapse { padding: 1rem 0; }
}
